{
    "name": "fsframework/factura-pdf1",
    "description": "Multi-document customer PDF printing plugin for FSFramework (FacturaPDF1 port).",
    "type": "library",
    "license": "LGPL-3.0-or-later",
    "version": "1.0.1",
    "require": {
        "php": ">=8.2",
        "rospdf/pdf-php": "^0.12"
    },
    "require-dev": {
        "smalot/pdfparser": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "FSFramework\\Plugins\\factura_pdf1\\": "./"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FacturaPdf1\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true
    }
}
